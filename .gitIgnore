########################################

## ملفات Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vsp
*.vspscc
*.vssscc

## ملفات Rider
.idea/
*.sln.iml
*.csproj.iml

########################################
# Build نتائج التجميع
########################################

[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
[Bb]uildOutput/
[Oo]utput/

########################################
# .NET Core
########################################

## نتائج التجميع
**/bin/
**/obj/
**/publish/
**/published/

## ملفات الإعداد
**/Properties/launchSettings.json
appsettings.*.json
!appsettings.json

## ملفات القفل
project.lock.json
project.fragment.lock.json
*.lock.json

## حزم
artifacts/
**/artifacts/

########################################
# NuGet Packages
########################################

*.nupkg
**/packages/
!**/packages/build/
**/[Pp]ackages/*
packages-*

########################################
# VS Code
########################################

.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

########################################
# أنظمة التشغيل
########################################

## Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

## macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

## Linux
*~

########################################
# اختبار و Coverlet
########################################

*.coverage
*.coveragexml
coverage*.json
coverage*.xml
TestResult.xml
*.VisualState.xml

########################################
# Docker
########################################

**/.dockerignore
**/Dockerfile
**/docker-compose.*.yml
**/docker-compose.*.yaml

########################################
# Azure
########################################

*.azure
*.pubxml
*.publishsettings

########################################
# Logs والمجلدات المؤقتة
########################################

*.log
*.tmp
*.temp
*.cache
*.orig
*.bak

########################################
# محدد لمشروعك (Sukun)
########################################

# يمكنك إضافة قواعد خاصة بمشروع Sukun هنا
# apps/backend/sukun/logs/
# apps/backend/sukun/temp/

########################################
# استثناءات مهمة (لا تتجاهل)
########################################

!**/.gitkeep
!**/.gitattributes
!**/.editorconfig
!**/.dockerignore
!**/.env.example
!**/README.md
!**/LICENSE
!**/CHANGELOG.md

########################################
# Node.js (إذا كان لديك frontend)
########################################

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/
out/
.nuxt/
.cache/

########################################
# قاعدة البيانات المحلية
########################################

*.mdf
*.ldf
*.sqlite
*.db
*.sdf
App_Data/

########################################
# ReSharper و Rider
########################################

_ReSharper*/
*.resharper
[Tt]est[Rr]esult*
[Bb]uild[Ll]og.*
*.dotCover
